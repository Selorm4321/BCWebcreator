{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.bcwebcreator.com" }],
      "destination": "https://bcwebcreator.com/:path*",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/surrey-web-design.html", "destination": "/surrey-langley-web-design.html", "permanent": true },
    { "source": "/langley-web-design.html", "destination": "/surrey-langley-web-design.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "bcwebcreator.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "index, follow" }]
    },
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "bcwebcreator.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
