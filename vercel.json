{
  "name": "typhoonhub-live",
  "version": 2,
  "builds": [
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "functions/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/functions/(.*)",
      "dest": "/functions/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
